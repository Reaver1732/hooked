generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Class {
  id             String   @id @default(uuid())
  /// 6 characters from an unambiguous alphabet (no 0/O, 1/I/L).
  code           String   @unique
  /// SHA-256 of the teacher key. The key itself is only ever shown to the teacher.
  teacherKeyHash String
  /// Kept in step with Player rows by the join/remove SQL in classes.ts, so the
  /// 60-player cap can be enforced atomically in a single statement.
  playerCount    Int      @default(0)
  createdAt      DateTime @default(now())
  /// Reset by joins, answers, and the teacher opening the dashboard or pressing
  /// "Keep this class". Classes idle for 7 days are deleted (see cleanup.ts).
  lastActivityAt DateTime @default(now())
  /// Percent a student's best finished attempt needs to count as "Passed".
  targetPercent  Int      @default(80)
  players        Player[]

  @@index([lastActivityAt])
}

model Player {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  nickname       String    @db.VarChar(20)
  /// SHA-256 of "<player id>:<rejoin code>". The code itself is shown once, never stored.
  rejoinCodeHash String?
  createdAt      DateTime  @default(now())
  attempts       Attempt[]
  answers        Answer[]

  @@index([classId])
}

/// One play-through of the message set. Finished once every current message is answered.
model Attempt {
  id         String    @id @default(uuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  answers    Answer[]

  @@index([playerId])
}

enum Choice {
  phish
  legit
}

model Answer {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  messageId String
  choice    Choice
  /// Graded by the server from shared/messages.ts, never taken from the client.
  correct   Boolean
  createdAt DateTime @default(now())

  /// Only the first answer to each message within an attempt counts.
  @@unique([attemptId, messageId])
}
